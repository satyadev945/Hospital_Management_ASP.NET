@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .access-denied-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            padding: 3rem;
            text-align: center;
            max-width: 600px;
        }

        .denied-icon {
            font-size: 5rem;
            color: #dc3545;
            margin-bottom: 1.5rem;
            animation: shake 0.5s;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-10px); }
            20%, 40%, 60%, 80% { transform: translateX(10px); }
        }

        h1 {
            color: #2c3e50;
            font-weight: 700;
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .error-code {
            color: #dc3545;
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        p {
            color: #6c757d;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
            color: white;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .btn-secondary {
            background: #6c757d;
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
            color: white;
            text-decoration: none;
            display: inline-block;
            margin-left: 1rem;
        }

        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.4);
            color: white;
            background: #5a6268;
        }

        .info-box {
            background: #f8f9fa;
            border-left: 4px solid #667eea;
            padding: 1rem;
            margin-top: 2rem;
            border-radius: 5px;
            text-align: left;
        }

        .info-box h5 {
            color: #2c3e50;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .info-box ul {
            margin: 0;
            padding-left: 1.5rem;
        }

        .info-box li {
            color: #495057;
            margin-bottom: 0.5rem;
        }
    </style>
</head>
<body>
    <div class="access-denied-container">
        <i class="fas fa-ban denied-icon"></i>
        <h1>Access Denied</h1>
        <div class="error-code">Error 403 - Forbidden</div>
        <p>
            You don't have permission to access this page. This area is restricted to authorized users only.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <p>
                You are currently logged in as <strong>@User.Identity.Name</strong>.
                If you believe you should have access to this page, please contact your system administrator.
            </p>
        }
        else
        {
            <p>
                You are not currently logged in. Please login with an authorized account to access this page.
            </p>
        }

        <div class="mt-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="javascript:history.back()" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Go Back
                </a>
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i> Go to Dashboard
                </a>
            }
            else
            {
                <a href="/Login?returnUrl=@Uri.EscapeDataString(HttpContext.Request.Path)" class="btn btn-primary">
                    <i class="fas fa-sign-in-alt"></i> Login
                </a>
                <a href="/" class="btn btn-secondary">
                    <i class="fas fa-home"></i> Go to Homepage
                </a>
            }
        </div>

        <div class="info-box">
            <h5><i class="fas fa-info-circle"></i> Common Reasons:</h5>
            <ul>
                <li>You are not logged in with the correct user type</li>
                <li>Your account doesn't have the required permissions</li>
                <li>The page you're trying to access is for administrators only</li>
                <li>Your session may have expired</li>
            </ul>
        </div>

        <div class="mt-3">
            <small class="text-muted">
                Need help? Contact our support team at support@hospital.com
            </small>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
