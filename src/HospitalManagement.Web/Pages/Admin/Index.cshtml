@page
@model IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h1>
            <p class="text-muted mb-0">Welcome back, @User.Identity?.Name</p>
        </div>
        <div>
            <span class="badge bg-success fs-6">
                <i class="fas fa-clock"></i> @DateTime.Now.ToString("MMMM dd, yyyy")
            </span>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Total Patients</h6>
                    <h2 class="mb-0 fw-bold">@Model.TotalPatients</h2>
                    <small class="text-success">
                        <i class="fas fa-arrow-up"></i> @Model.NewPatientsThisMonth new this month
                    </small>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-user-injured"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Total Doctors</h6>
                    <h2 class="mb-0 fw-bold">@Model.TotalDoctors</h2>
                    <small class="text-info">
                        <i class="fas fa-user-check"></i> @Model.ActiveDoctors active
                    </small>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-user-md"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Total Staff</h6>
                    <h2 class="mb-0 fw-bold">@Model.TotalStaff</h2>
                    <small class="text-success">
                        <i class="fas fa-users"></i> All departments
                    </small>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card info">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Departments</h6>
                    <h2 class="mb-0 fw-bold">@Model.TotalDepartments</h2>
                    <small class="text-primary">
                        <i class="fas fa-building"></i> @Model.ActiveDepartments active
                    </small>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-building"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="text-muted small mb-1">Today's Appointments</div>
                        <div class="h4 mb-0 fw-bold">@Model.TodayAppointments</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-calendar-day fa-2x text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="text-muted small mb-1">Pending Appointments</div>
                        <div class="h4 mb-0 fw-bold">@Model.PendingAppointments</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-clock fa-2x text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="text-muted small mb-1">Completed Today</div>
                        <div class="h4 mb-0 fw-bold">@Model.CompletedAppointments</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="text-muted small mb-1">Total Revenue</div>
                        <div class="h4 mb-0 fw-bold">$@Model.TotalRevenue.ToString("N0")</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-dollar-sign fa-2x text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-calendar-check"></i> Recent Appointments</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentAppointments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Patient</th>
                                    <th>Doctor</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in Model.RecentAppointments)
                                {
                                    <tr>
                                        <td>#@appointment.AppointID</td>
                                        <td>
                                            <i class="fas fa-user-injured text-primary"></i>
                                            @appointment.Patient?.Name
                                        </td>
                                        <td>
                                            <i class="fas fa-user-md text-success"></i>
                                            @appointment.Doctor?.Name
                                        </td>
                                        <td>@appointment.Date?.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        <td>
                                            @{
                                                var statusBadge = appointment.AppointmentStatus switch
                                                {
                                                    1 => "badge bg-success",
                                                    2 => "badge bg-warning",
                                                    3 => "badge bg-info",
                                                    4 => "badge bg-danger",
                                                    _ => "badge bg-secondary"
                                                };
                                                var statusText = appointment.AppointmentStatus switch
                                                {
                                                    1 => "Approved",
                                                    2 => "Pending",
                                                    3 => "Completed",
                                                    4 => "Rejected",
                                                    _ => "Unknown"
                                                };
                                            }
                                            <span class="@statusBadge">@statusText</span>
                                        </td>
                                        <td>
                                            <a href="/Appointment/Details/@appointment.AppointID" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-calendar-times fa-3x mb-3"></i>
                        <p>No recent appointments found.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-building"></i> Department Overview</h5>
            </div>
            <div class="card-body">
                @if (Model.Departments.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var dept in Model.Departments.Take(5))
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <h6 class="mb-0">@dept.DeptName</h6>
                                    <small class="text-muted">
                                        <i class="fas fa-user-md"></i> @dept.Doctors.Count doctors
                                    </small>
                                </div>
                                <span class="badge bg-primary rounded-pill">@dept.Doctors.Count</span>
                            </div>
                        }
                    </div>
                    <div class="text-center mt-3">
                        <a href="/Admin/ManageDepartments" class="btn btn-sm btn-outline-primary">
                            View All Departments <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">
                        <p>No departments found.</p>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-tasks"></i> Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Admin/ManageDoctors" class="btn btn-outline-primary">
                        <i class="fas fa-user-md"></i> Manage Doctors
                    </a>
                    <a href="/Admin/ManagePatients" class="btn btn-outline-success">
                        <i class="fas fa-user-injured"></i> View Patients
                    </a>
                    <a href="/Admin/ManageStaff" class="btn btn-outline-warning">
                        <i class="fas fa-users"></i> Manage Staff
                    </a>
                    <a href="/Admin/ManageDepartments" class="btn btn-outline-info">
                        <i class="fas fa-building"></i> Manage Departments
                    </a>
                    <a href="/Reports" class="btn btn-outline-secondary">
                        <i class="fas fa-chart-bar"></i> View Reports
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-primary {
        border-left: 4px solid #667eea !important;
    }
    .border-left-success {
        border-left: 4px solid #198754 !important;
    }
    .border-left-warning {
        border-left: 4px solid #ffc107 !important;
    }
    .border-left-info {
        border-left: 4px solid #0dcaf0 !important;
    }
</style>
