@page
@model HospitalManagement.Web.Pages.Doctor.PendingAppointmentsModel
@{
    ViewData["Title"] = "Pending Appointments";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Pending Appointments</li>
                </ol>
            </nav>
            <h1 class="display-5 text-primary">Pending Appointment Requests</h1>
            <p class="lead text-muted">Review and manage pending appointment requests</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-clock-history text-warning me-2"></i>
                                Pending Requests (@Model.PendingAppointments.Count)
                            </h5>
                        </div>
                        <div class="col-auto">
                            <button onclick="location.reload()" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-clockwise"></i> Refresh
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.PendingAppointments != null && Model.PendingAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Appointment ID</th>
                                        <th>Patient Name</th>
                                        <th>Requested Date & Time</th>
                                        <th>Status</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in Model.PendingAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@appointment.AppointID</strong>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-circle bg-primary bg-opacity-10 text-primary me-2">
                                                        @appointment.PatientName?.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <strong>@appointment.PatientName</strong>
                                                </div>
                                            </td>
                                            <td>
                                                <i class="bi bi-calendar3 text-muted me-1"></i>
                                                @appointment.Date.ToString("MMM dd, yyyy")
                                                <br>
                                                <small class="text-muted">
                                                    <i class="bi bi-clock text-muted me-1"></i>
                                                    @appointment.Date.ToString("hh:mm tt")
                                                </small>
                                            </td>
                                            <td>
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-hourglass-split me-1"></i>Pending
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <form method="post" asp-page-handler="Approve" class="d-inline">
                                                        <input type="hidden" name="appointmentId" value="@appointment.AppointID" />
                                                        <button type="submit" class="btn btn-sm btn-success"
                                                                onclick="return confirm('Are you sure you want to approve this appointment?');">
                                                            <i class="bi bi-check-circle"></i> Approve
                                                        </button>
                                                    </form>
                                                    <form method="post" asp-page-handler="Reject" class="d-inline ms-1">
                                                        <input type="hidden" name="appointmentId" value="@appointment.AppointID" />
                                                        <button type="submit" class="btn btn-sm btn-danger"
                                                                onclick="return confirm('Are you sure you want to reject this appointment?');">
                                                            <i class="bi bi-x-circle"></i> Reject
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-check text-muted" style="font-size: 4rem;"></i>
                            <h4 class="text-muted mt-3">No Pending Appointments</h4>
                            <p class="text-muted">All appointment requests have been processed.</p>
                            <a asp-page="Index" class="btn btn-primary mt-3">
                                <i class="bi bi-house-door"></i> Back to Dashboard
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.PendingAppointments != null && Model.PendingAppointments.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-info-circle me-2"></i>Quick Tips
                        </h6>
                        <ul class="mb-0 text-muted small">
                            <li>Review each appointment request carefully before approving or rejecting.</li>
                            <li>Approved appointments will appear in your "Today's Appointments" if scheduled for today.</li>
                            <li>Rejected appointments will be notified to the patients automatically.</li>
                            <li>You can view your complete appointment history in the Patient History section.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1rem;
    }
</style>
