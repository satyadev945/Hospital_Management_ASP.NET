@page
@model HospitalManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Patient History";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Patient History</li>
                </ol>
            </nav>
            <h1 class="display-5 text-primary">Patient Treatment History</h1>
            <p class="lead text-muted">View complete treatment history of your patients</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Search by Patient Name</label>
                            <input type="text" name="searchTerm" class="form-control"
                                   placeholder="Enter patient name..." value="@Model.SearchTerm">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">From Date</label>
                            <input type="date" name="fromDate" class="form-control"
                                   value="@Model.FromDate?.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">To Date</label>
                            <input type="date" name="toDate" class="form-control"
                                   value="@Model.ToDate?.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="row align-items-center">
                        <div class="col">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-file-medical text-success me-2"></i>
                                Treatment Records (@Model.PatientHistory.Count)
                            </h5>
                        </div>
                        <div class="col-auto">
                            <button onclick="window.print()" class="btn btn-sm btn-outline-primary me-2">
                                <i class="bi bi-printer"></i> Print
                            </button>
                            <button onclick="exportToCSV()" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-file-earmark-spreadsheet"></i> Export
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.PatientHistory != null && Model.PatientHistory.Any())
                    {
                        <div class="table-responsive">
                            <table id="historyTable" class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Doctor Name</th>
                                        <th>Diagnosed Disease</th>
                                        <th>Progress Made</th>
                                        <th>Prescription</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model.PatientHistory)
                                    {
                                        <tr>
                                            <td>
                                                <i class="bi bi-calendar3 text-muted me-1"></i>
                                                @record.Date
                                            </td>
                                            <td>
                                                <strong>@record.DoctorName</strong>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(record.DiagnosedDisease))
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger">
                                                        @record.DiagnosedDisease
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not specified</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(record.ProgressMade))
                                                {
                                                    <div class="text-truncate" style="max-width: 200px;"
                                                         title="@record.ProgressMade">
                                                        @record.ProgressMade
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(record.Prescription))
                                                {
                                                    <div class="text-truncate" style="max-width: 250px;"
                                                         title="@record.Prescription">
                                                        @record.Prescription
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-info"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#detailModal"
                                                        onclick="showDetails('@record.Date', '@record.DoctorName', '@record.DiagnosedDisease', '@record.ProgressMade', '@record.Prescription')">
                                                    <i class="bi bi-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-journal-medical text-muted" style="font-size: 4rem;"></i>
                            <h4 class="text-muted mt-3">No Treatment History Found</h4>
                            @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.FromDate.HasValue || Model.ToDate.HasValue)
                            {
                                <p class="text-muted">No records match your search criteria.</p>
                                <a asp-page="PatientHistory" class="btn btn-primary mt-3">
                                    <i class="bi bi-arrow-clockwise"></i> Clear Filters
                                </a>
                            }
                            else
                            {
                                <p class="text-muted">You haven't completed any patient treatments yet.</p>
                                <a asp-page="TodaysAppointments" class="btn btn-primary mt-3">
                                    <i class="bi bi-calendar-check"></i> View Today's Appointments
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.PatientHistory != null && Model.PatientHistory.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <h4 class="text-primary">@Model.PatientHistory.Count</h4>
                                <small class="text-muted">Total Treatments</small>
                            </div>
                            <div class="col-md-3">
                                <h4 class="text-success">@Model.PatientHistory.Select(p => p.DoctorName).Distinct().Count()</h4>
                                <small class="text-muted">Unique Patients</small>
                            </div>
                            <div class="col-md-3">
                                <h4 class="text-info">@Model.PatientHistory.Count(p => !string.IsNullOrEmpty(p.Prescription))</h4>
                                <small class="text-muted">With Prescription</small>
                            </div>
                            <div class="col-md-3">
                                <h4 class="text-warning">@Model.PatientHistory.Count(p => !string.IsNullOrEmpty(p.DiagnosedDisease))</h4>
                                <small class="text-muted">Diagnosed</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="detailModalLabel">
                    <i class="bi bi-file-medical me-2"></i>Treatment Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Date of Treatment</label>
                        <p class="fw-bold" id="modalDate"></p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Treating Doctor</label>
                        <p class="fw-bold" id="modalDoctor"></p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="text-muted small">Diagnosed Disease</label>
                        <p class="fw-bold" id="modalDisease"></p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="text-muted small">Progress Made</label>
                        <p id="modalProgress"></p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <label class="text-muted small">Prescription</label>
                        <p id="modalPrescription"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        function showDetails(date, doctor, disease, progress, prescription) {
            document.getElementById('modalDate').textContent = date || 'N/A';
            document.getElementById('modalDoctor').textContent = doctor || 'N/A';
            document.getElementById('modalDisease').textContent = disease || 'Not specified';
            document.getElementById('modalProgress').textContent = progress || 'No progress notes';
            document.getElementById('modalPrescription').textContent = prescription || 'No prescription';
        }

        function exportToCSV() {
            var table = document.getElementById('historyTable');
            var csv = [];
            var rows = table.querySelectorAll('tr');

            for (var i = 0; i < rows.length - 1; i++) {
                var row = [], cols = rows[i].querySelectorAll('td, th');

                for (var j = 0; j < cols.length - 1; j++) {
                    var text = cols[j].innerText.replace(/"/g, '""');
                    row.push('"' + text + '"');
                }

                csv.push(row.join(','));
            }

            var csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
            var downloadLink = document.createElement('a');
            downloadLink.download = 'patient_history_' + new Date().toISOString().slice(0,10) + '.csv';
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = 'none';
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}

<style>
    @@media print {
        .no-print {
            display: none !important;
        }
    }
</style>
