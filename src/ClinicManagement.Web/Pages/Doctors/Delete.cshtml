@page "{id:int}"
@model ClinicManagement.Web.Pages.Doctors.DeleteModel
@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Delete Doctor
                    </h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h4 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill"></i> Warning!
                        </h4>
                        <p class="mb-0">Are you sure you want to delete this doctor? This action cannot be undone.</p>
                    </div>

                    <h4 class="mt-4">Doctor Information:</h4>
                    
                    <dl class="row">
                        <dt class="col-sm-4">
                            <i class="bi bi-person"></i> Name:
                        </dt>
                        <dd class="col-sm-8">
                            <strong>Dr. @Model.Doctor.FirstName @Model.Doctor.LastName</strong>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-award"></i> Specialization:
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.Doctor.Specialization</span>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-card-text"></i> License Number:
                        </dt>
                        <dd class="col-sm-8">
                            <code>@Model.Doctor.LicenseNumber</code>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-envelope"></i> Email:
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Doctor.Email
                        </dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-telephone"></i> Phone:
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Doctor.PhoneNumber
                        </dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-activity"></i> Status:
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.Doctor.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-x-circle"></i> Inactive
                                </span>
                            }
                        </dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="Doctor.Id" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete Doctor
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
