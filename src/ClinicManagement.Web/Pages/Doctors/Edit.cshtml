@page "{id:int}"
@model ClinicManagement.Web.Pages.Doctors.EditModel
@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning">
                    <h2 class="mb-0">
                        <i class="bi bi-pencil"></i> Edit Doctor
                    </h2>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Doctor.Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Doctor.FirstName" class="form-label"></label>
                                <input asp-for="Doctor.FirstName" class="form-control" />
                                <span asp-validation-for="Doctor.FirstName" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="Doctor.LastName" class="form-label"></label>
                                <input asp-for="Doctor.LastName" class="form-control" />
                                <span asp-validation-for="Doctor.LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Doctor.Specialization" class="form-label"></label>
                                <select asp-for="Doctor.Specialization" class="form-select">
                                    <option value="">-- Select Specialization --</option>
                                    <option value="General Practice">General Practice</option>
                                    <option value="Cardiology">Cardiology</option>
                                    <option value="Dermatology">Dermatology</option>
                                    <option value="Neurology">Neurology</option>
                                    <option value="Orthopedics">Orthopedics</option>
                                    <option value="Pediatrics">Pediatrics</option>
                                    <option value="Psychiatry">Psychiatry</option>
                                    <option value="Radiology">Radiology</option>
                                    <option value="Surgery">Surgery</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Doctor.Specialization" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="Doctor.LicenseNumber" class="form-label"></label>
                                <input asp-for="Doctor.LicenseNumber" class="form-control" />
                                <span asp-validation-for="Doctor.LicenseNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Doctor.Email" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Doctor.Email" class="form-control" type="email" />
                            </div>
                            <span asp-validation-for="Doctor.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Doctor.PhoneNumber" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Doctor.PhoneNumber" class="form-control" type="tel" />
                            </div>
                            <span asp-validation-for="Doctor.PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="Doctor.IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="Doctor.IsActive" class="form-check-label"></label>
                            </div>
                            <span asp-validation-for="Doctor.IsActive" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Update Doctor
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
