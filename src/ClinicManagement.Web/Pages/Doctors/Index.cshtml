@page
@model ClinicManagement.Web.Pages.Doctors.IndexModel
@{
    ViewData["Title"] = "Doctors";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h1>
                <i class="bi bi-person-badge"></i> Doctors
            </h1>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add New Doctor
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <form method="get">
                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        <label class="col-form-label">Search:</label>
                    </div>
                    <div class="col-md-4">
                        <input type="text" name="searchString" value="@Model.SearchString" 
                               class="form-control" placeholder="Search by name, email, or specialization...">
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a asp-page="./Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
        <div class="card-body">
            @if (Model.Doctors.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Specialization</th>
                                <th>License Number</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doctor in Model.Doctors)
                            {
                                <tr>
                                    <td>
                                        <strong>Dr. @doctor.FirstName @doctor.LastName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">
                                            <i class="bi bi-award"></i> @doctor.Specialization
                                        </span>
                                    </td>
                                    <td><code>@doctor.LicenseNumber</code></td>
                                    <td>@doctor.Email</td>
                                    <td>@doctor.PhoneNumber</td>
                                    <td>
                                        @if (doctor.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-x-circle"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="./Details" asp-route-id="@doctor.Id" 
                                               class="btn btn-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-page="./Edit" asp-route-id="@doctor.Id" 
                                               class="btn btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-page="./Delete" asp-route-id="@doctor.Id" 
                                               class="btn btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> 
                    @if (!string.IsNullOrEmpty(Model.SearchString))
                    {
                        <text>No doctors found matching "@Model.SearchString".</text>
                    }
                    else
                    {
                        <text>No doctors registered yet. Click "Add New Doctor" to get started.</text>
                    }
                </div>
            }
        </div>
        @if (Model.Doctors.Any())
        {
            <div class="card-footer">
                <p class="mb-0 text-muted">
                    <strong>Total:</strong> @Model.Doctors.Count() doctor(s)
                </p>
            </div>
        }
    </div>
</div>
