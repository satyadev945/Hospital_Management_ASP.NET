@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4">
                <i class="bi bi-hospital"></i> Clinic Management Dashboard
            </h1>
            <p class="lead">Welcome to the Clinic Management System</p>
            <hr class="my-4">
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-people"></i> Patients
                    </h5>
                </div>
                <div class="card-body">
                    <h2 class="card-title display-4">@Model.TotalPatients</h2>
                    <p class="card-text">Total registered patients</p>
                    <a asp-page="/Patients/Index" class="btn btn-light">
                        <i class="bi bi-list-ul"></i> View All
                    </a>
                    <a asp-page="/Patients/Create" class="btn btn-outline-light">
                        <i class="bi bi-plus-circle"></i> Add New
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-person-badge"></i> Doctors
                    </h5>
                </div>
                <div class="card-body">
                    <h2 class="card-title display-4">@Model.TotalDoctors</h2>
                    <p class="card-text">Total registered doctors</p>
                    <a asp-page="/Doctors/Index" class="btn btn-light">
                        <i class="bi bi-list-ul"></i> View All
                    </a>
                    <a asp-page="/Doctors/Create" class="btn btn-outline-light">
                        <i class="bi bi-plus-circle"></i> Add New
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-info mb-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-check"></i> Appointments
                    </h5>
                </div>
                <div class="card-body">
                    <h2 class="card-title display-4">@Model.TodayAppointments</h2>
                    <p class="card-text">Appointments today</p>
                    <a href="#" class="btn btn-light">
                        <i class="bi bi-calendar3"></i> View Schedule
                    </a>
                    <a href="#" class="btn btn-outline-light">
                        <i class="bi bi-plus-circle"></i> Book New
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history"></i> Recent Activity
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentPatients.Any())
                    {
                        <h6 class="text-muted">Recently Registered Patients</h6>
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var patient in Model.RecentPatients.Take(5))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-person-circle text-primary"></i>
                                        <strong>@patient.FirstName @patient.LastName</strong>
                                        <small class="text-muted">- @patient.Email</small>
                                    </div>
                                    <a asp-page="/Patients/Details" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No recent activity to display.</p>
                    }

                    @if (Model.RecentDoctors.Any())
                    {
                        <h6 class="text-muted">Recently Registered Doctors</h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var doctor in Model.RecentDoctors.Take(5))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-person-badge-fill text-success"></i>
                                        <strong>Dr. @doctor.FirstName @doctor.LastName</strong>
                                        <small class="text-muted">- @doctor.Specialization</small>
                                    </div>
                                    <a asp-page="/Doctors/Details" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-success">
                                        View
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-page="/Patients/Create" class="btn btn-primary">
                            <i class="bi bi-person-plus"></i> Register New Patient
                        </a>
                        <a asp-page="/Doctors/Create" class="btn btn-success">
                            <i class="bi bi-person-badge"></i> Register New Doctor
                        </a>
                        <a href="#" class="btn btn-info text-white">
                            <i class="bi bi-calendar-plus"></i> Schedule Appointment
                        </a>
                        <a href="#" class="btn btn-warning text-white">
                            <i class="bi bi-file-earmark-medical"></i> View Medical Records
                        </a>
                        <a href="#" class="btn btn-secondary">
                            <i class="bi bi-graph-up"></i> Generate Report
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle"></i> System Information
                    </h5>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Version:</strong> 1.0.0</p>
                    <p class="mb-1"><strong>Last Updated:</strong> @DateTime.Now.ToString("MMM dd, yyyy")</p>
                    <p class="mb-0"><strong>Status:</strong> <span class="badge bg-success">Online</span></p>
                </div>
            </div>
        </div>
    </div>
</div>
