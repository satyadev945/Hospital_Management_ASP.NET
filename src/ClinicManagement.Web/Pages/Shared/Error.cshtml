@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h1 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Error
                    </h1>
                </div>
                <div class="card-body">
                    <h2 class="text-danger">An error occurred while processing your request.</h2>
                    
                    @if (Model.ShowRequestId)
                    {
                        <p class="mt-3">
                            <strong>Request ID:</strong> <code>@Model.RequestId</code>
                        </p>
                    }

                    <div class="mt-4">
                        <h3>What can you do?</h3>
                        <ul>
                            <li>Go back to the <a asp-page="/Index">home page</a></li>
                            <li>Try refreshing the page</li>
                            <li>Contact support if the problem persists</li>
                        </ul>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ExceptionMessage))
                    {
                        <div class="alert alert-warning mt-4">
                            <h4>Technical Details:</h4>
                            <p>@Model.ExceptionMessage</p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-page="/Index" class="btn btn-primary">
                        <i class="bi bi-house-door"></i> Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
